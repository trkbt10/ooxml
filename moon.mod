name = "trkbt10/ooxml"

version = "0.1.0"

import {
  "moonbitlang/x@0.4.43",
  "mizchi/svg@0.2.1",
  "mizchi/font@0.7.3",
  "trkbt10/osenv@0.1.0",
  "mizchi/image@0.4.2",
}

readme = "README.mbt.md"

repository = ""

license = "Apache-2.0"

keywords = [ "ooxml", "ecma-376", "xlsx", "pptx", "docx", "office" ]

description = "OOXML (ECMA-376) parsing, building, and rendering library for Office formats (xlsx/pptx/docx) in MoonBit."

options(
  source: "src",
)
