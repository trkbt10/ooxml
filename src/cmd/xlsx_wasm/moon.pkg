// WASM build target for the .xlsx facade.

import {
  "trkbt10/ooxml/xlsx" @xlsx,
}

options(
  "is-main": true,
  link: {
    "wasm-gc": {
      "exports": [
        "xlsx_package_name:package_name",
        "xlsx_open",
        "xlsx_save",
        "xlsx_to_html",
        "xlsx_to_svg",
      ],
    },
  },
)
