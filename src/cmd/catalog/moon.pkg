// trkbt10/ooxml — ECMA-376 schema catalog + coverage tool.
//
// Build:  moon build --target native --release src/cmd/catalog
//
// Walks the ECMA-376 XSD schema sets, enumerates every element
// declaration, synthesises a minimal schema-valid instance for each,
// embeds it into a host OOXML package, and exercises the full
// round-trip — this package's builder writes the package, its
// reader opens it, the reader saves it, the reader re-opens it, and
// the renderer produces SVG.  Writes .snapshots/catalog.json and
// .snapshots/coverage.json.
//
// This replaces the former Python xsd_catalog.py / catalog_verify.py:
// the catalog and its verification are produced by the same MoonBit
// toolchain — and the same builder / reader / renderer — as the
// library under test.

import {
  "moonbitlang/core/string",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/core/env",
  "moonbitlang/x/fs",
  "trkbt10/ooxml/xml",
  "trkbt10/ooxml/zip",
  "trkbt10/ooxml/ecma376/opc",
  "trkbt10/ooxml/ecma376/wordprocessing_ml/context" @wml_context,
  "trkbt10/ooxml/ecma376/spreadsheet_ml/context" @sml_context,
  "trkbt10/ooxml/ecma376/spreadsheet_ml/viewer" @sml_viewer,
  "trkbt10/ooxml/ecma376/spreadsheet_ml/sparkline" @sml_sparkline,
  "trkbt10/ooxml/ecma376/presentation_ml/context" @pml_context,
  "trkbt10/ooxml/util/glyph",
}

options(
  "is-main": true,
)
