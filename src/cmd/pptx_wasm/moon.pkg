// WASM build target for the .pptx facade.

import {
  "trkbt10/ooxml/ecma376/presentation_ml/context" @pml_context,
}

options(
  "is-main": true,
  link: {
    "wasm-gc": {
      "exports": [
        "pptx_package_name:package_name",
        "pptx_open",
        "pptx_save",
        "pptx_to_html",
        "pptx_to_svg",
      ],
    },
  },
)
