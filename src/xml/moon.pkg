// XML 1.0 (W3C) reader/writer used as the foundation of every OOXML part.
//
// Scope: namespaces, prefixes, attributes, character references, CDATA.
// Out of scope: ECMA-376-specific concepts (those live in `ecma376/...`).

import {
  // UTF-8 encode/decode is required for the public Bytes reader/writer API.
  "moonbitlang/core/encoding/utf8",
}
