// trkbt10/ooxml/ecma376/wordprocessing_ml/numbering_resolver
//
// WordprocessingML §17.9 numbering inheritance: num → abstractNum →
// lvl resolution with §17.9.8 lvlOverride wins and §17.9.21
// numStyleLink follow-up. CT_*/ST_* types live in
// `@wordprocessing_ml/domain`; this package keeps the resolver
// pipeline, the §17.9.11 lvlText formatter, and runtime provenance
// markers.

import {
  "trkbt10/ooxml/xml" @xml,
  "trkbt10/ooxml/ecma376/wordprocessing_ml/domain" @domain,
}

import {
  "moonbitlang/core/encoding/utf8" @utf8,
} for "wbtest"
