// trkbt10/ooxml/ecma376/wordprocessing_ml/context
//
// WordprocessingML context — parser-built Document tree + IO (open
// / save) + render queries (to_svg) +
// pure read APIs (resolve_paragraph_style / resolve_run_style /
// resolve_style_by_id / resolve_paragraph_numbering /
// decode_simple_field / evaluate_simple_field /
// open_embedded_font / embedded_font_parts). Mutators live in the
// sibling `edit/` package.

import {
  "trkbt10/ooxml/ecma376/simple_types",
  "trkbt10/ooxml/ecma376/opc/namespaces" @opc_namespaces,
  "trkbt10/ooxml/ecma376/opc/errors" @opc_errors,
  "trkbt10/ooxml/ecma376/opc/part_name" @opc_part_name,
  "trkbt10/ooxml/ecma376/opc",
  "trkbt10/ooxml/ecma376/opc/relationships",
  "trkbt10/ooxml/ecma376/wordprocessing_ml/domain" @wml,
  "trkbt10/ooxml/ecma376/wordprocessing_ml/reader" @wml_reader,
  "trkbt10/ooxml/ecma376/wordprocessing_ml/builder" @wml_builder,
  "trkbt10/ooxml/ecma376/wordprocessing_ml/style_resolver" @wml_style_resolver,
  "trkbt10/ooxml/ecma376/wordprocessing_ml/numbering_resolver" @wml_numbering,
  "trkbt10/ooxml/ecma376/wordprocessing_ml/field_eval" @wml_field_eval,
  "trkbt10/ooxml/ecma376/wordprocessing_ml/viewer" @wml_viewer,
  "trkbt10/ooxml/util/markup",
  "mizchi/font" @mizchi_font,
  "trkbt10/ooxml/util/base64",
  "trkbt10/ooxml/xml",
  "trkbt10/ooxml/zip",
}

import {
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/x/fs",
  "trkbt10/ooxml/util/glyph",
  "trkbt10/ooxml/ecma376/wordprocessing_ml/edit" @wml_edit,
} for "wbtest"
