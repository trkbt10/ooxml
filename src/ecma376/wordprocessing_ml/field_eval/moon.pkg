// trkbt10/ooxml/ecma376/wordprocessing_ml/field_eval
//
// WordprocessingML §17.16 field code parser and evaluator. Tokenises
// the §17.16.1 instruction grammar, decodes both `w:fldSimple/@w:instr`
// and `w:fldChar` Begin..End run sequences, and evaluates the
// canonical field instructions defined in §17.16.5.* against a
// supplied FieldContext.

import {
  "moonbitlang/core/hashmap" @hashmap,
  "trkbt10/ooxml/ecma376/opc/errors" @opc_errors,
  "trkbt10/ooxml/xml" @xml,
  "trkbt10/ooxml/ecma376/wordprocessing_ml/domain" @domain,
  "trkbt10/ooxml/ecma376/spreadsheet_ml/date_serial" @date_serial,
}

import {
  "moonbitlang/core/encoding/utf8" @utf8,
} for "wbtest"
