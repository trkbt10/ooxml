// trkbt10/ooxml/ecma376/spreadsheet_ml/edit
//
// B-layer mutators for the SpreadsheetML context. Top-level
// functions only — every helper consumes a
// `@sml_context.Workbook`, composes A-layer primitives (`@edit`,
// `@opc`, context facade-edit primitives), and returns a new
// context. No method is defined on `Workbook` directly.

import {
  "trkbt10/ooxml/ecma376/opc/errors" @opc_errors,
  "trkbt10/ooxml/ecma376/opc/part_name" @opc_part_name,
  "trkbt10/ooxml/ecma376/opc" @opc,
  "trkbt10/ooxml/ecma376/spreadsheet_ml/domain" @sml,
  "trkbt10/ooxml/ecma376/spreadsheet_ml/builder" @sml_builder,
  "trkbt10/ooxml/ecma376/spreadsheet_ml/context" @sml_context,
  "trkbt10/ooxml/xml" @xml,
  "trkbt10/ooxml/edit" @a_edit,
  "moonbitlang/core/string" @string,
}
