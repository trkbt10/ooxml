// trkbt10/ooxml/ecma376/spreadsheet_ml/context
//
// SpreadsheetML context — parser-built Workbook tree + IO (open /
// save) + render queries (to_svg). Pure
// reader/builder/render direction. Mutating helpers live in the
// sibling `edit/` package.

import {
  "trkbt10/ooxml/ecma376/opc/namespaces" @opc_namespaces,
  "trkbt10/ooxml/ecma376/opc/errors" @opc_errors,
  "trkbt10/ooxml/ecma376/opc/part_name" @opc_part_name,
  "trkbt10/ooxml/ecma376/opc" @opc,
  "trkbt10/ooxml/ecma376/opc/relationships" @relationships,
  "trkbt10/ooxml/ecma376/spreadsheet_ml/domain" @sml,
  "trkbt10/ooxml/ecma376/spreadsheet_ml/reader" @sml_reader,
  "trkbt10/ooxml/ecma376/spreadsheet_ml/builder" @sml_builder,
  "trkbt10/ooxml/ecma376/spreadsheet_ml/cf_rule_eval" @sml_cf_eval,
  "trkbt10/ooxml/ecma376/spreadsheet_ml/autofilter" @sml_autofilter,
  "trkbt10/ooxml/ecma376/spreadsheet_ml/pivot_table" @sml_pivot,
  "trkbt10/ooxml/ecma376/spreadsheet_ml/formula" @sml_formula,
  "trkbt10/ooxml/ecma376/spreadsheet_ml/address" @sml_address,
  "trkbt10/ooxml/ecma376/spreadsheet_ml/date_serial" @sml_date_serial,
  "trkbt10/ooxml/ecma376/spreadsheet_ml/viewer" @sml_viewer,
  "trkbt10/ooxml/ecma376/spreadsheet_ml/drawing" @drawing,
  "trkbt10/ooxml/util/markup" @markup,
  "trkbt10/ooxml/edit" @edit,
  "trkbt10/ooxml/util/base64" @base64,
  "trkbt10/ooxml/xml" @xml,
  "trkbt10/ooxml/zip" @zip,
  "moonbitlang/core/strconv" @strconv,
}

import {
  "moonbitlang/core/encoding/utf8" @utf8,
  "moonbitlang/x/fs" @fs,
  "trkbt10/ooxml/ecma376/spreadsheet_ml/edit" @sml_edit,
} for "wbtest"
