///|
/// ECMA-376 Part 1 §22.1: Office Math (OMML) facade.
///
/// The package owns shared-math.xsd symbols for mathPr, oMathPara, oMath,
/// the 72 CT_* domain types, 14 ST_* simple types, and the OMML reader and
/// builder pipeline.
pub fn package_name() -> String {
  "trkbt10/ooxml/ecma376/office_math"
}
