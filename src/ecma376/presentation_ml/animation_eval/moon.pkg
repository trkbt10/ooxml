// trkbt10/ooxml/ecma376/presentation_ml/animation_eval
//
// ECMA-376 Part 1 §19.5 PresentationML animation timing engine —
// decodes `<p:timing>` (CT_SlideTiming) into a typed time-node tree
// and evaluates it at a given target time. Covers par / seq / excl
// containers, anim / animClr / animMotion / animRot / animScale /
// set / cmd leaves, cBhvr common behaviour data, tav / tavLst
// keypoints, and stCondLst / endCondLst / nextCondLst / prevCondLst
// condition lists. Time semantics per §19.7.38 ST_TLTime,
// §19.7.40 ST_TLTimeIndefinite, §19.7.41 ST_TLTimeNodeFillType,
// §19.7.45 ST_TLTimeNodeRestartType, §19.7.47 ST_TLTimeNodeType,
// §19.7.48 ST_TLTriggerEvent.

import {
  "moonbitlang/core/strconv",
  "trkbt10/ooxml/ecma376/opc/errors" @opc_errors,
  "trkbt10/ooxml/xml",
  "trkbt10/ooxml/ecma376/presentation_ml/domain",
}

import {
  "moonbitlang/core/encoding/utf8",
} for "wbtest"
