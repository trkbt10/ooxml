///|
/// Return the implementation package identifier for ecma376/opc/part. This
/// package owns the ECMA-376 OPC part SDD scope for §9 Thumbnails plus the §4
/// opc-coreProperties and opc-digSig schema facts exposed by its public domain,
/// reader, and writer APIs.
pub fn package_name() -> String {
  "trkbt10/ooxml/ecma376/opc/part"
}
