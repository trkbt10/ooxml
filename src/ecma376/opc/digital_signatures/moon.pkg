// trkbt10/ooxml/ecma376/opc/digital_signatures
//
// ECMA-376 Part 2 §10 Digital Signatures part. Implements the opc-digSig
// schema (RelationshipReference, RelationshipsGroupReference,
// SignatureTime, ST_Format, ST_Value, etc.) plus the §10.* normative
// chapters on signing process, validation, and the relationships
// transform algorithm.

import {
  "trkbt10/ooxml/ecma376/opc/errors" @opc_errors,
  "trkbt10/ooxml/xml" @xml,
  "moonbitlang/core/encoding/base64" @base64,
  "moonbitlang/core/encoding/utf8" @utf8,
  "moonbitlang/x/crypto" @crypto,
}
