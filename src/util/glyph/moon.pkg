// trkbt10/ooxml/util/glyph
//
// Real-font measurement layer driven by a swappable `FontResolver`.
// Every metric (advance, kerning, ascender, descender, line-gap) is
// read at runtime from the TTF/TTC bytes returned by the resolver —
// no statistical fallback, no hard-coded per-font tables. When the
// resolver cannot satisfy a request the call raises
// `FontUnresolvedError`; callers decide whether to retry through
// the ECMA-376 §17.8.3.1 substitution chain or surface the failure
// at the document boundary.
//
// References:
//   - ECMA-376 Part 1 §17.8.3 (WML font table and substitution).
//   - ECMA-376 Part 1 §20.1.4.2.1 (DML fontScheme).
//   - mizchi/font (sfnt / cmap / hmtx / hhea / OS2 / ttc parser).
//   - trkbt10/osenv (cross-platform OS / dirs detection).

import {
  "mizchi/font" @font,
  "moonbitlang/core/env" @env,
  "moonbitlang/x/fs" @fs,
  "trkbt10/osenv/dirs" @dirs,
  "trkbt10/osenv/path" @path,
  "trkbt10/osenv/platform" @platform,
}

import {
  "moonbitlang/core/debug" @debug,
} for "wbtest"
